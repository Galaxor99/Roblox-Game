    <Item class="ModuleScript" referent="RBX00000005">
      <Properties>
        <string name="Name">NexusConfig</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">local C = {}
C.Version = 4
C.Rarities = {"Common", "Rare", "Epic", "Legendary", "Mythic", "Celestial"}
C.RarityColors = {Common=Color3.fromRGB(165,165,175), Rare=Color3.fromRGB(80,155,255), Epic=Color3.fromRGB(190,90,250), Legendary=Color3.fromRGB(255,186,45), Mythic=Color3.fromRGB(255,70,100), Celestial=Color3.fromRGB(80,240,240)}
C.Cards = {
  recruit={Name="Rift Recruit",Rarity="Common",Power=90,Speed=75,Defense=100,Energy=70,Trait="Reliable",Color=Color3.fromRGB(125,160,210)},
  spark={Name="Spark Runner",Rarity="Common",Power=80,Speed=125,Defense=70,Energy=90,Trait="Swift",Color=Color3.fromRGB(80,205,250)},
  sentinel={Name="Iron Sentinel",Rarity="Rare",Power=155,Speed=65,Defense=210,Energy=115,Trait="Guardian",Color=Color3.fromRGB(155,190,220)},
  ember={Name="Ember Ronin",Rarity="Rare",Power=200,Speed=155,Defense=95,Energy=125,Trait="Blazing",Color=Color3.fromRGB(255,140,70)},
  frost={Name="Frost Warden",Rarity="Epic",Power=290,Speed=180,Defense=260,Energy=210,Trait="Chill",Color=Color3.fromRGB(110,215,255)},
  thunder={Name="Thunder Vanguard",Rarity="Epic",Power=340,Speed=350,Defense=165,Energy=275,Trait="Surge",Color=Color3.fromRGB(170,100,250)},
  eclipse={Name="Eclipse Knight",Rarity="Legendary",Power=620,Speed=420,Defense=470,Energy=550,Trait="Eclipse",Color=Color3.fromRGB(180,90,235)},
  comet={Name="Comet Drifter",Rarity="Legendary",Power=540,Speed=710,Defense=250,Energy=600,Trait="Momentum",Color=Color3.fromRGB(240,110,130)},
  sovereign={Name="Shadow Sovereign",Rarity="Mythic",Power=1120,Speed=750,Defense=680,Energy=1270,Trait="Legion",Color=Color3.fromRGB(105,90,200)},
  oracle={Name="Chrono Oracle",Rarity="Mythic",Power=850,Speed=1240,Defense=630,Energy=1380,Trait="Foresight",Color=Color3.fromRGB(90,220,220)},
  astral={Name="Astral Monarch",Rarity="Celestial",Power=2250,Speed=1450,Defense=1700,Energy=2400,Trait="Transcendent",Color=Color3.fromRGB(240,215,100)},
}
-- Weights are percentages, total 100. Each pack has its own pool and pity threshold.
C.Packs = {
  basic={Name="Rift Pack",Price=100,Weights={Common=55,Rare=25,Epic=12,Legendary=6,Mythic=1.8,Celestial=0.2},Pity=30,Description="Balanced starter summons"},
  elite={Name="Ascendant Pack",Price=350,Weights={Common=0,Rare=45,Epic=34,Legendary=16,Mythic=4.5,Celestial=0.5},Pity=18,Description="Rare or better guaranteed"},
  cosmic={Name="Cosmic Pack",Price=1000,Weights={Common=0,Rare=0,Epic=55,Legendary=30,Mythic=13,Celestial=2},Pity=10,Description="Epic or better guaranteed"},
}
C.Expeditions = {
  scouting={Name="Rift Scouting",Duration=30,RequiredPower=250,Reward=125,Unlock=0},
  citadel={Name="Broken Citadel",Duration=90,RequiredPower=1250,Reward=450,Unlock=5},
  abyss={Name="Astral Abyss",Duration=180,RequiredPower=4000,Reward=1400,Unlock=15},
}
-- Increasing permanent luck costs and expedition milestones.
C.LuckUpgradeCosts={1000,2500,5000,9000,15000,24000,37000,55000,80000,120000}
C.LuckExpeditionRequirements={2,5,10,18,30,45,65,90,125,170}
C.LuckCost = 1000 -- legacy compatibility
C.LuckMaxLevel = 10
C.LuckBonusPerLevel = 0.08 -- multiplies Epic+ weights; automatically renormalised
C.FreeStarterCoins = 600
C.Monetization={
 LuckPassId=0, -- Add an actual GAME PASS ID after creating it in Creator Hub.
 PotionProductIds={minor=0,major=0}, -- Actual DEVELOPER PRODUCT IDs.
}
C.Potions={
 minor={Name="Lucky Draught",Bonus=0.25,Duration=600,Ingredients={Essence=8,Crystals=2}},
 major={Name="Astral Elixir",Bonus=0.75,Duration=900,Ingredients={Essence=24,Crystals=8}},
}
-- Luck factors multiply Epic+ rarity weights (not guaranteed probabilities).
-- 2x Game Pass doubles the entire base-plus-permanent-plus-potion boost factor.
-- Boosts do not stack with themselves; strongest potion wins.


-- Release 4 roster: original characters grouped into expedition factions.
C.Factions={Rift="Riftborn",Neon="Neon Vanguard",Arcane="Arcane Covenant",Astral="Astral Court"}
local factions={recruit="Rift",spark="Neon",sentinel="Neon",ember="Rift",frost="Arcane",thunder="Neon",eclipse="Arcane",comet="Astral",sovereign="Arcane",oracle="Astral",astral="Astral"}
for id,faction in pairs(factions) do C.Cards[id].Faction=faction end
local additions={
 {"tide","Tide Apprentice","Common",85,90,80,95,"Flow","Arcane",70,190,220},
 {"scout","Rooftop Scout","Common",75,130,65,95,"Agile","Neon",120,230,160},
 {"warden","Grove Warden","Rare",140,90,230,140,"Roots","Rift",95,190,110},
 {"gunslinger","Nova Gunslinger","Rare",190,180,90,130,"Precision","Astral",235,165,90},
 {"phantom","Phantom Courier","Epic",310,370,140,265,"Phase","Neon",135,110,245},
 {"witch","Glass Witch","Epic",300,205,200,360,"Prism","Arcane",220,140,230},
 {"titan","Verdant Titan","Legendary",560,220,850,440,"Bastion","Rift",90,200,130},
 {"captain","Solar Corsair","Legendary",600,550,360,610,"Broadside","Astral",245,165,65},
 {"archon","Neon Archon","Mythic",1000,1150,550,1100,"Overdrive","Neon",70,230,235},
 {"seraph","Dawn Seraph","Mythic",970,800,950,1120,"Renewal","Rift",250,210,145},
 {"weaver","Fate Weaver","Celestial",2050,1800,1450,2500,"Destiny","Arcane",215,160,250},
 {"leviathan","Star Leviathan","Celestial",2400,1000,2200,2150,"Gravity","Astral",95,175,250},
}
for _,v in ipairs(additions) do
 C.Cards[v[1]]={Name=v[2],Rarity=v[3],Power=v[4],Speed=v[5],Defense=v[6],Energy=v[7],Trait=v[8],Faction=v[9],Color=Color3.fromRGB(v[10],v[11],v[12])}
end
C.Achievements={
 {Id="first_summon",Name="A Rift Awakens",Stat="Rolls",Target=1,Coins=100,Essence=2},
 {Id="ten_summons",Name="Summoner in Training",Stat="Rolls",Target=10,Coins=250,Essence=8},
 {Id="fifty_summons",Name="Nexus Collector",Stat="Rolls",Target=50,Coins=800,Essence=20},
 {Id="first_journey",Name="Beyond the Gate",Stat="Completed",Target=1,Coins=125,Essence=3},
 {Id="ten_journeys",Name="Rift Pathfinder",Stat="Completed",Target=10,Coins=500,Essence=15},
 {Id="five_cards",Name="A Growing Alliance",Stat="Unique",Target=5,Coins=200,Essence=5},
 {Id="fifteen_cards",Name="Worlds United",Stat="Unique",Target=15,Coins=1000,Essence=30},
}


-- Identity fields are data only; no franchise assets are bundled.
local expanded={
 {"velocity","Velocity Zero","Mythic",1100,1500,400,900,"Momentum","Neon",255,90,100},
 {"aegis","Aegis Inventor","Epic",330,240,280,330,"Overclock","Neon",220,100,75},
 {"blade","Silent Blade","Rare",210,190,95,85,"Precision","Arcane",150,160,230},
 {"dune","Dune Wanderer","Common",100,85,110,55,"Endurance","Rift",220,180,120},
 {"ocean","Ocean Regent","Legendary",570,350,650,580,"Tidal","Rift",65,165,215},
 {"raven","Raven Tactician","Epic",260,300,260,370,"Strategy","Neon",130,125,185},
 {"sunforge","Sunforge Knight","Legendary",650,310,700,440,"Bulwark","Arcane",245,195,80},
 {"dream","Dream Cartographer","Rare",120,150,110,230,"Insight","Astral",175,130,230},
 {"moss","Moss Sprite","Common",65,95,80,135,"Renewal","Rift",125,210,140},
 {"ghost","Ghost Navigator","Epic",240,340,180,410,"Phase","Astral",130,220,220},
 {"crown","Crowned Paradox","Celestial",2100,2000,1400,2400,"Causality","Astral",240,160,230},
 {"lunar","Lunar Huntress","Rare",180,200,100,130,"Tracking","Arcane",120,150,220},
 {"atlas","Atlas Engine","Mythic",1200,450,1450,900,"Fortress","Neon",170,185,205},
}
for _,v in ipairs(expanded) do
 C.Cards[v[1]]={Name=v[2],Rarity=v[3],Power=v[4],Speed=v[5],Defense=v[6],Energy=v[7],Trait=v[8],Faction=v[9],Color=Color3.fromRGB(v[10],v[11],v[12])}
end
for id,card in pairs(C.Cards) do
 card.Identity={DisplayName=card.Name,ModelName=id,PortraitAssetId=0,LicenseStatus="Original",PublicEligible=true}
end
-- Upload the four original-character atlases and set their Roblox image IDs.
C.PortraitAtlases={}
for index=1,23 do C.PortraitAtlases[index]=0 end
local atlasOrder={
 {"recruit","spark","sentinel","ember","frost","thunder","eclipse","comet","sovereign"},
 {"tide","scout","warden","gunslinger","phantom","witch","titan","captain","archon"},
 {"oracle","astral","seraph","weaver","leviathan","velocity","aegis","blade","dune"},
 {"ocean","raven","sunforge","dream","moss","ghost","crown","lunar","atlas"},
}
for atlas,ids in ipairs(atlasOrder) do
 for index,id in ipairs(ids) do
  C.Cards[id].Identity.PortraitAtlas=atlas
  C.Cards[id].Identity.PortraitAtlasCell=index
 end
end
C.CardLore={
 recruit="The first volunteer to map the broken gates. Steady hands make dangerous routes feel possible.",
 spark="A courier who once crossed the Sanctuary in a heartbeat. Swift teams reach their destination sooner.",
 sentinel="An old city defender rebuilt to shelter Riftwalkers from the unknown.",
 ember="A wandering blade who follows the glow of unstable gateways.",
 frost="Guardian of the northern archives, where frozen memories remain intact.",
 thunder="A restless Vanguard who turns the Citadel's storm into a path forward.",
 eclipse="An oathbound knight searching for the moment the sky went dark.",
 comet="A pilot who reads star trails as maps through broken realities.",
 sovereign="Commander of a vanished host, remembered by the shadows it left behind.",
 oracle="A keeper of future fragments who sees several endings at once.",
 astral="The last monarch to hear the original signal from beyond the Fracture.",
 tide="A patient apprentice who listens to the currents flowing between realms.",
 scout="A rooftop runner who knows every hidden approach to the Neon Citadel.",
 warden="The grove's quiet protector, rooted beside its oldest memory.",
 gunslinger="An explorer who keeps one bright flare for the darkest rift.",
 phantom="A messenger who slips through the static before a signal fades.",
 witch="A prism scholar who splits a single clue into many possible truths.",
 titan="A living shelter grown where the Sanctuary's defenses failed.",
 captain="A solar navigator charting courses through impossible skies.",
 archon="The Citadel's forgotten engine given will and purpose.",
 seraph="A dawn watcher who promises that lost worlds can bloom again.",
 weaver="An artisan of uncertain fates, collecting the threads between memories.",
 leviathan="A vast traveler sleeping beneath the light of the Astral Expanse.",
 velocity="A messenger who treats every second as a door to another path.",
 aegis="A maker of protective devices for journeys no map can predict.",
 blade="A quiet duelist who learns more from a pause than from a strike.",
 dune="A survivor who crossed the silent wastes after the first fracture.",
 ocean="A ruler who guards the tides that connect scattered shores.",
 raven="A strategist tracing the pattern hidden in the Citadel's blackouts.",
 sunforge="A shield bearer forged in the last warm light of a dying world.",
 dream="A cartographer drawing routes remembered only in sleep.",
 moss="A small spirit proving that even a broken realm can regrow.",
 ghost="A guide who follows the faint signals of lost travelers.",
 crown="A paradox given form at the edge of every possible ending.",
 lunar="A patient tracker who reads the night for traces of the Rift.",
 atlas="A walking citadel built to carry a city's last hope.",
}
for id,lore in pairs(C.CardLore) do C.Cards[id].Lore=lore end
C.WorldOrder={"hub","neon","astral"}
C.Worlds={
 hub={Name="Nexus Sanctuary",Completed=0,Cost=0,Color=Color3.fromRGB(90,150,210)},
 neon={Name="Neon Citadel",Completed=5,Cost=500,Color=Color3.fromRGB(180,90,245)},
 astral={Name="Astral Expanse",Completed=15,Cost=1800,Color=Color3.fromRGB(80,215,205)},
}
C.Expeditions.scouting.World="hub";C.Expeditions.citadel.World="neon";C.Expeditions.abyss.World="astral"
C.BossOrder={"guardian","overseer","fracture"}
C.Bosses={
 guardian={Name="The Rift Guardian",World="hub",Power=900,Reward=180,Essence=6,Crystals=1,Stat="Defense",Duration=45},
 overseer={Name="Neon Overseer",World="neon",Power=4500,Reward=550,Essence=15,Crystals=3,Stat="Speed",Duration=75},
 fracture={Name="Heart of the Fracture",World="astral",Power=14000,Reward=1500,Essence=35,Crystals=8,Stat="Energy",Duration=120},
}
C.VariantOrder={"Normal","Shiny","Corrupted","Awakened","Celestial"}
C.Variants={
 Normal={Weight=9700,Multiplier=1},Shiny={Weight=250,Multiplier=1.10},Corrupted={Weight=40,Multiplier=1.20},Awakened={Weight=9,Multiplier=1.35},Celestial={Weight=1,Multiplier=1.50},
}
C.CardMaxLevel=100
C.Formations={Line={Completed=0},Arc={Completed=5},Orbit={Completed=15}}
C.MasteryMaxRank=10
C.Awakening={Level=25,MasteryRank=5,BossWins=3,Essence=250,Crystals=12,PowerMultiplier=1.25}
C.ExpeditionRoutes={
 steady={Name="Steady Passage",Chance=1,Reward=1,Duration=1,Stat="Defense",Description="Reliable route that favors a durable team"},
 swift={Name="Swift Passage",Chance=.92,Reward=1.2,Duration=.7,Stat="Speed",Description="Shorter journey with a speed advantage"},
 perilous={Name="Perilous Passage",Chance=.72,Reward=1.65,Duration=1.15,Stat="Energy",Description="Hard route with greater rewards"},
}
C.Bosses.guardian.WeaknessTraits={Guardian=true,Bulwark=true,Bastion=true}
C.Bosses.overseer.WeaknessTraits={Swift=true,Agile=true,Overdrive=true}
C.Bosses.fracture.WeaknessTraits={Foresight=true,Destiny=true,Insight=true}
C.Discoveries={
 hub={"hub_archive","hub_observatory","hub_garden"},
 neon={"neon_workshop","neon_transit","neon_signal"},
 astral={"astral_vault","astral_spire","astral_echo"},
}
C.DiscoveryNames={
 hub_archive="Rift Archive",hub_observatory="Fracture Observatory",hub_garden="Memory Garden",
 neon_workshop="Signal Workshop",neon_transit="Skyrail Terminal",neon_signal="Lost Broadcast",
 astral_vault="Starlit Vault",astral_spire="Celestial Spire",astral_echo="Origin Echo",
}
C.ChapterOrder={"fracture","neon","astral"}
C.Chapters={
 fracture={Name="Chapter I: The Fracture",World="hub",Completed=2,BossWins=0,Card="warden",Coins=400,Essence=15,Story="The sky above the Sanctuary cracked without a sound. Three memories remain among the groves; recover them to trace the first Riftwalker."},
 neon={Name="Chapter II: Broken Signals",World="neon",Completed=8,BossWins=1,Card="gunslinger",Coins=750,Essence=35,Story="The Citadel's lights still answer a signal sent before the Fracture. Find its workshop, transit line and final broadcast to learn who opened the gate."},
 astral={Name="Chapter III: The Origin Echo",World="astral",Completed=20,BossWins=4,Card="oracle",Coins=1800,Essence=75,Story="Beyond the city, an echo repeats every fate the Nexus might have followed. Reach the vault, the spire and the origin to restore the first memory."},
}
C.WeeklyEvents={
 {Id="rift_memory",Name="Rift Memory Week",Description="Recover echoes of the first fracture",Card="frost"},
 {Id="neon_signal",Name="Neon Signal Week",Description="Reconnect the broken city",Card="thunder"},
 {Id="astral_convergence",Name="Astral Convergence Week",Description="Trace the origin of the Nexus",Card="comet"},
}
C.WeeklyMilestones={
 {Id="first",Points=5,Coins=200,Essence=5},
 {Id="second",Points=15,Coins=550,Essence=18},
 {Id="final",Points=35,Coins=1000,Essence=40,EventCard=true},
}
C.QuestOrder={"first_steps","neon_path","astral_path"}
C.Quests={
 first_steps={Name="Answer the Nexus",Stat="Completed",Target=2,Card="sentinel",Coins=150},
 neon_path={Name="A Spark of Hope",Stat="Completed",Target=8,Card="phantom",Coins=350},
 astral_path={Name="Beyond the Fracture",Stat="BossWins",Target=5,Card="comet",Coins=700},
}
C.CollectionSets={
 {Id="first_alliance",Name="First Alliance",Cards={"recruit","spark","sentinel","ember"},Coins=250,Essence=10},
 {Id="rift_guardians",Name="Guardians of the Rift",Cards={"warden","titan","seraph","ocean"},Coins=600,Essence=25},
 {Id="neon_legends",Name="Neon Legends",Cards={"phantom","archon","velocity","atlas"},Coins=1200,Essence=40},
 {Id="astral_court",Name="Astral Court",Cards={"comet","oracle","astral","leviathan"},Coins=1500,Essence=50},
}
C.RosterMode="Development" -- Public mode excludes unverified identities from summons; stored collections remain intact.
C.IdentityOverrides={} -- Stable card ID -&gt; identity fields; keep IDs to preserve collections.
require(script.Parent:WaitForChild("NexusRoster")).apply(C)
C.TraitEffects={}
local function trait(route,bonus,names)
 for _,name in ipairs(names) do C.TraitEffects[name]={Route=route,ChanceBonus=bonus} end
end
trait("steady",.05,{"Reliable","Guardian","Chill","Roots","Bastion","Renewal","Endurance","Bulwark","Fortress","Tidal"})
trait("swift",.06,{"Swift","Momentum","Phase","Agile","Tracking","Precision","Flow"})
trait("perilous",.06,{"Blazing","Surge","Eclipse","Legion","Foresight","Transcendent","Prism","Broadside","Overdrive","Destiny","Gravity","Strategy","Insight"})
for _,card in pairs(C.Cards) do if not C.TraitEffects[card.Trait] then C.TraitEffects[card.Trait]={Route="steady",ChanceBonus=.03} end end
return C
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="NEXUS_SOURCE_01">
      <Properties>
        <string name="Name">NexusRoster</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Configurable development identities. No portraits, likenesses, audio or models bundled.
-- Public mode excludes entries without confirmed rights metadata.
local Roster={}
local groups={
 {Universe='Dragon Ball',Faction='Astral',Names={'Goku','Vegeta','Gohan','Piccolo','Trunks','Broly','Frieza','Beerus','Whis','Android 18'}},
 {Universe='Naruto',Faction='Arcane',Names={'Naruto Uzumaki','Sasuke Uchiha','Kakashi Hatake','Sakura Haruno','Itachi Uchiha','Madara Uchiha','Gaara','Rock Lee','Minato Namikaze','Hinata Hyuga'}},
 {Universe='One Piece',Faction='Rift',Names={'Monkey D. Luffy','Roronoa Zoro','Nami','Sanji','Trafalgar Law','Shanks','Nico Robin','Portgas D. Ace','Jinbe','Tony Tony Chopper'}},
 {Universe='Bleach',Faction='Arcane',Names={'Ichigo Kurosaki','Rukia Kuchiki','Renji Abarai','Byakuya Kuchiki','Sosuke Aizen','Kisuke Urahara'}},
 {Universe='Jujutsu Kaisen',Faction='Arcane',Names={'Yuji Itadori','Megumi Fushiguro','Nobara Kugisaki','Satoru Gojo','Ryomen Sukuna','Yuta Okkotsu'}},
 {Universe='Demon Slayer',Faction='Rift',Names={'Tanjiro Kamado','Nezuko Kamado','Zenitsu Agatsuma','Inosuke Hashibira','Kyojuro Rengoku','Shinobu Kocho'}},
 {Universe='My Hero Academia',Faction='Neon',Names={'Izuku Midoriya','Katsuki Bakugo','Shoto Todoroki','All Might','Ochaco Uraraka','Hawks'}},
 {Universe='Hunter x Hunter',Faction='Rift',Names={'Gon Freecss','Killua Zoldyck','Kurapika','Leorio','Hisoka','Meruem'}},
 {Universe='Solo Leveling',Faction='Arcane',Names={'Sung Jinwoo','Cha Hae-In','Igris','Beru'}},
 {Universe='Attack on Titan',Faction='Rift',Names={'Eren Yeager','Mikasa Ackerman','Armin Arlert','Levi Ackerman'}},
 {Universe='Fullmetal Alchemist',Faction='Arcane',Names={'Edward Elric','Alphonse Elric','Roy Mustang','Riza Hawkeye'}},
 {Universe='DC',Faction='Neon',Names={'Superman','Batman','Wonder Woman','The Flash','Green Lantern','Aquaman','Raven','Cyborg','Supergirl','Nightwing'}},
 {Universe='Marvel',Faction='Neon',Names={'Spider-Man','Iron Man','Captain America','Thor','Hulk','Black Panther','Doctor Strange','Scarlet Witch','Wolverine','Storm'}},
 {Universe='Star Wars',Faction='Astral',Names={'Luke Skywalker','Darth Vader','Leia Organa','Obi-Wan Kenobi','Ahsoka Tano','Yoda','Din Djarin','Rey'}},
 {Universe='The Lord of the Rings',Faction='Arcane',Names={'Gandalf','Aragorn','Legolas','Gimli','Frodo Baggins','Galadriel'}},
 {Universe='Avatar: The Last Airbender',Faction='Rift',Names={'Aang','Katara','Zuko','Toph Beifong','Sokka','Azula'}},
 {Universe='Arcane',Faction='Neon',Names={'Vi','Jinx','Caitlyn','Ekko'}},
 {Universe='The Matrix',Faction='Neon',Names={'Neo','Trinity','Morpheus','Agent Smith'}},
 {Universe='Harry Potter',Faction='Arcane',Names={'Harry Potter','Hermione Granger','Ron Weasley','Albus Dumbledore'}},
 {Universe='Devil May Cry',Faction='Arcane',Names={'Dante','Vergil','Nero','Lady'}},
 {Universe='Final Fantasy',Faction='Astral',Names={'Cloud Strife','Tifa Lockhart','Aerith Gainsborough','Sephiroth'}},
 {Universe='God of War',Faction='Rift',Names={'Kratos','Atreus','Freya','Mimir'}},
 {Universe='Sonic the Hedgehog',Faction='Neon',Names={'Sonic','Shadow','Knuckles','Tails'}},
 {Universe='The Legend of Zelda',Faction='Arcane',Names={'Link','Zelda','Ganondorf','Midna'}},
 {Universe='Street Fighter',Faction='Rift',Names={'Ryu','Chun-Li','Ken Masters','Akuma'}},
 {Universe='Halo',Faction='Astral',Names={'Master Chief','Cortana','The Arbiter','Sergeant Johnson'}},
 {Universe='Metroid',Faction='Astral',Names={'Samus Aran','Dark Samus','Ridley','Raven Beak'}},
 {Universe='Chainsaw Man',Faction='Rift',Names={'Denji','Power','Aki Hayakawa','Makima'}},
 {Universe='One-Punch Man',Faction='Neon',Names={'Saitama','Genos','Tatsumaki','Garou'}},
 {Universe='Frieren',Faction='Arcane',Names={'Frieren','Fern','Stark','Himmel'}},
}
local function slug(s) return string.lower(s):gsub('[^%w]+','_'):gsub('_$','') end
function Roster.apply(config)
 local rarities={'Rare','Epic','Legendary','Mythic','Rare','Epic','Legendary','Celestial','Common','Rare'}
 local bases={Common=90,Rare=175,Epic=310,Legendary=600,Mythic=1050,Celestial=2200}
 local traits={'Precision','Momentum','Guardian','Foresight','Reliable','Surge'}
 local portraitIndex=0
 for groupIndex,group in ipairs(groups) do for i,name in ipairs(group.Names) do
  portraitIndex+=1
  local id='fiction_'..slug(group.Universe)..'_'..slug(name)
  local override=config.IdentityOverrides[id] or {}
  local eligible=override.PublicEligible==true
  do
   local rarity=override.Rarity or rarities[(i+groupIndex-2)%#rarities+1]
   local base=bases[rarity];local tilt=((i*7+groupIndex*3)%9-4)/20
   local display=override.DisplayName or name
   config.Cards[id]={Enabled=config.RosterMode=='Development' or eligible,Name=display,Rarity=rarity,Power=math.floor(base*(1+tilt)),Speed=math.floor(base*(1-tilt)),Defense=math.floor(base*.85),Energy=math.floor(base*1.1),Trait=traits[(i-1)%#traits+1],Faction=group.Faction,Universe=group.Universe,Lore="An echo from "..group.Universe..". Its "..string.lower(traits[(i-1)%#traits+1]).." style can change an expedition.",Color=config.RarityColors[rarity],Identity={DisplayName=display,CanonicalName=name,Universe=group.Universe,ModelName=override.ModelName or id,PortraitAssetId=override.PortraitAssetId or 0,PortraitAtlas=4+math.ceil(portraitIndex/9),PortraitAtlasCell=(portraitIndex-1)%9+1,LicenseStatus=override.LicenseStatus or 'Unverified',PublicEligible=eligible}}
  end
 end end
end
return Roster
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="NEXUS_SOURCE_02">
      <Properties>
        <string name="Name">NexusProgression</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Pure progression rules: no Instances, clocks, network calls or persistence.
local P = {}
function P.new(config)
 local self = {}
 local ranks = {}; for i,r in ipairs(config.Rarities) do ranks[r]=i end
 function self.sanitize(raw, collection, now)
  raw=type(raw)=='table' and raw or {}
  local state={Team={},Levels={},Claims={},DailyDay=-1,DailyStreak=0,Worlds={hub=true},BossWins=0,Challenge=nil,Variants={},Quests={},Sets={},Formation="Line",MasteryXp={},Awakened={},Discoveries={},Chapters={},Weekly={Week=-1,Points=0,Claims={}},CoopClaims={}}
  local seen={}
  if type(raw.Team)=='table' then for _,id in ipairs(raw.Team) do
   if #state.Team&lt;5 and config.Cards[id] and (collection[id] or 0)&gt;0 and not seen[id] then table.insert(state.Team,id); seen[id]=true end
  end end
  if type(raw.Levels)=='table' then for id,level in pairs(raw.Levels) do
   if config.Cards[id] and type(level)=='number' and level==level then state.Levels[id]=math.clamp(math.floor(level),1,config.CardMaxLevel) end
  end end
  if type(raw.Claims)=='table' then for _,goal in ipairs(config.Achievements) do if raw.Claims[goal.Id]==true then state.Claims[goal.Id]=true end end end
  for _,key in ipairs({'DailyDay','DailyStreak'}) do
   local n=raw[key]; if type(n)=='number' and n==n then state[key]=math.clamp(math.floor(n),key=='DailyDay' and -1 or 0,1000000) end
  end
  if config.Formations[raw.Formation] then state.Formation=raw.Formation end
  if type(raw.Quests)=='table' then for id in pairs(config.Quests) do if raw.Quests[id]==true then state.Quests[id]=true end end end
  if type(raw.Sets)=='table' then for _,set in ipairs(config.CollectionSets) do if raw.Sets[set.Id]==true then state.Sets[set.Id]=true end end end
  if type(raw.Chapters)=='table' then for id in pairs(config.Chapters) do if raw.Chapters[id]==true then state.Chapters[id]=true end end end
  if type(raw.Weekly)=='table' and type(raw.Weekly.Week)=='number' and raw.Weekly.Week==raw.Weekly.Week then
   state.Weekly.Week=math.clamp(math.floor(raw.Weekly.Week),-1,1000000)
   if type(raw.Weekly.Points)=='number' and raw.Weekly.Points==raw.Weekly.Points then state.Weekly.Points=math.clamp(math.floor(raw.Weekly.Points),0,1000000) end
   if type(raw.Weekly.Claims)=='table' then for _,milestone in ipairs(config.WeeklyMilestones) do if raw.Weekly.Claims[milestone.Id]==true then state.Weekly.Claims[milestone.Id]=true end end end
  end
  if type(raw.CoopClaims)=='table' then
   local today=math.floor((now or os.time())/86400)
   for key,value in pairs(raw.CoopClaims) do
    local day=tonumber(key)
    if type(key)=='string' and day and day==math.floor(day) and day&gt;=today-14 and day&lt;=today and value==true then state.CoopClaims[key]=true end
   end
  end
  if type(raw.Discoveries)=='table' then for _,list in pairs(config.Discoveries) do for _,id in ipairs(list) do if raw.Discoveries[id]==true then state.Discoveries[id]=true end end end end
  if type(raw.Worlds)=='table' then for id in pairs(config.Worlds) do if raw.Worlds[id]==true then state.Worlds[id]=true end end end
  if type(raw.BossWins)=='number' and raw.BossWins==raw.BossWins then state.BossWins=math.clamp(math.floor(raw.BossWins),0,1000000) end
  if type(raw.Challenge)=='table' and config.Bosses[raw.Challenge.Id] and type(raw.Challenge.EndsAt)=='number' and type(raw.Challenge.Success)=='boolean' then
   local team={};local seen={}
   if type(raw.Challenge.Team)=='table' then for _,id in ipairs(raw.Challenge.Team) do if #team&lt;5 and config.Cards[id] and not seen[id] then table.insert(team,id);seen[id]=true end end end
   state.Challenge={Id=raw.Challenge.Id,EndsAt=math.floor(raw.Challenge.EndsAt),Success=raw.Challenge.Success,Team=team}
  end
  for id,count in pairs(collection) do if config.Cards[id] and count&gt;0 then
   if type(raw.MasteryXp)=='table' then local xp=raw.MasteryXp[id];if type(xp)=='number' and xp==xp then state.MasteryXp[id]=math.clamp(math.floor(xp),0,100000) end end
   if type(raw.Awakened)=='table' and raw.Awakened[id]==true then state.Awakened[id]=true end
   local variants={};local remaining=count
   local saved=type(raw.Variants)=='table' and raw.Variants[id]
   if type(saved)=='table' then
    for i=#config.VariantOrder,2,-1 do
     local name=config.VariantOrder[i];local n=saved[name]
     if type(n)=='number' and n==n then local valid=math.clamp(math.floor(n),0,remaining);if valid&gt;0 then variants[name]=valid;remaining-=valid end end
    end
   end
   variants.Normal=remaining;state.Variants[id]=variants
  end end
  return state
 end
 function self.masteryRank(p,id)
  local xp=p.Progression.MasteryXp[id] or 0
  local rank=1
  while rank&lt;config.MasteryMaxRank and xp&gt;=rank*50 do xp-=rank*50;rank+=1 end
  return rank,xp,rank&lt;config.MasteryMaxRank and rank*50 or 0
 end
 function self.grantMastery(p,team,amount)
  local seen={}
  for _,id in ipairs(team or {}) do
   if not seen[id] and config.Cards[id] and (p.Collection[id] or 0)&gt;0 then
    seen[id]=true;p.Progression.MasteryXp[id]=math.min(100000,(p.Progression.MasteryXp[id] or 0)+amount)
   end
  end
 end
 function self.event(now)
  local week=math.floor(now/604800)
  return config.WeeklyEvents[(week%#config.WeeklyEvents)+1],week,(week+1)*604800
 end
 function self.eventProgress(p,now)
  local _,week=self.event(now)
  local saved=p.Progression.Weekly
  if saved.Week~=week then return {Week=week,Points=0,Claims={}} end
  return {Week=week,Points=saved.Points,Claims=table.clone(saved.Claims)}
 end
 function self.addEventPoints(p,now,points)
  local _,week=self.event(now)
  local weekly=p.Progression.Weekly
  if weekly.Week~=week then weekly.Week=week;weekly.Points=0;weekly.Claims={} end
  weekly.Points=math.min(1000000,weekly.Points+points)
 end
 function self.cardPower(p,id)
  local c=config.Cards[id]; if not c then return 0 end
  local level=p.Progression.Levels[id] or 1
  local variant=1
  for name,count in pairs(p.Progression.Variants[id] or {}) do if count&gt;0 then variant=math.max(variant,config.Variants[name].Multiplier) end end
  local awakened=p.Progression.Awakened[id] and config.Awakening.PowerMultiplier or 1
  return math.floor(awakened*variant*(c.Power+c.Speed*.35+c.Defense*.35+c.Energy*.3)*(1+(level-1)*.06))
 end
 function self.team(p)
  local team=table.clone(p.Progression.Team)
  if #team==0 then
   for id,n in pairs(p.Collection) do if n&gt;0 and config.Cards[id] then table.insert(team,id) end end
   table.sort(team,function(a,b) local x,y=self.cardPower(p,a),self.cardPower(p,b); return x==y and a&lt;b or x&gt;y end)
   while #team&gt;5 do table.remove(team) end
  end
  local total=0; local factions={}
  for _,id in ipairs(team) do
   total+=self.cardPower(p,id)
   local faction=config.Cards[id].Faction or 'Rift'; factions[faction]=(factions[faction] or 0)+1
  end
  local synergy=0
  for _,count in pairs(factions) do if count&gt;=3 then synergy=math.max(synergy,.15) elseif count&gt;=2 then synergy=math.max(synergy,.05) end end
  return math.floor(total*(1+synergy)),team,synergy
 end
 function self.upgradeCost(p,id)
  local card=config.Cards[id]; if not card then return nil end
  local level=p.Progression.Levels[id] or 1
  if level&gt;=config.CardMaxLevel then return nil end
  return {Coins=75*level*(ranks[card.Rarity] or 1),Essence=level*2,Duplicates=1}
 end
 function self.addCard(p,id,variant)
  p.Collection[id]=(p.Collection[id] or 0)+1
  local variants=p.Progression.Variants[id] or {};p.Progression.Variants[id]=variants
  variants[variant]=(variants[variant] or 0)+1
 end
 function self.consumeDuplicate(p,id)
  local variants=p.Progression.Variants[id] or {}
  -- Only normal duplicates are consumed automatically. Rare variants are protected.
  if (variants.Normal or 0)&lt;1 or p.Collection[id]&lt;2 then return false end
  variants.Normal-=1;p.Collection[id]-=1;return true
 end
 function self.rollVariant(number)
  local total=0
  for _,name in ipairs(config.VariantOrder) do total+=config.Variants[name].Weight;if number&lt;total then return name end end
  return 'Normal'
 end
 function self.bossChance(p,id)
  local boss=config.Bosses[id];if not boss then return 0 end
  local power,team=self.team(p);local stat=0;local traitBonus=0
  for _,cardId in ipairs(team) do
   local card=config.Cards[cardId];stat+=card[boss.Stat] or 0
   if boss.WeaknessTraits and boss.WeaknessTraits[card.Trait] then traitBonus+=.04 end
  end
  local affinity=math.min(.25,stat/(boss.Power*2))
  return math.clamp(power/boss.Power*(1+affinity+math.min(.12,traitBonus)),.05,.98)
 end
 function self.expeditionPlan(p,id,routeId)
  local expedition=config.Expeditions[id]
  local route=config.ExpeditionRoutes[routeId]
  if not expedition or not route then return nil end
  local power,team=self.team(p)
  local speed=0;local favored=0;local traitBonus=0
  for _,cardId in ipairs(team) do
   local card=config.Cards[cardId];speed+=card.Speed
   favored+=card[route.Stat] or 0
   local effect=config.TraitEffects[card.Trait]
   if effect and effect.Route==routeId then traitBonus+=effect.ChanceBonus end
  end
  local statBonus=math.min(.18,favored/(expedition.RequiredPower*3))
  local chance=math.clamp((power/expedition.RequiredPower)*(1+statBonus+math.min(.15,traitBonus))*route.Chance,.2,.98)
  local duration=math.max(10,math.ceil(expedition.Duration*route.Duration*(1-math.min(.25,speed/10000))))
  local reward=math.floor(expedition.Reward*route.Reward)
  return {Chance=chance,Duration=duration,Reward=reward,Team=team,Route=routeId,TraitBonus=math.min(.15,traitBonus)}
 end
 function self.startBoss(p,id,now,roll)
  local boss=type(id)=='string' and config.Bosses[id]
  if not boss then return false,'Unknown boss' end
  if not p.Progression.Worlds[boss.World] then return false,'Unlock this world first' end
  if p.Progression.Challenge then return false,'Claim the current boss challenge first' end
  local _,team=self.team(p)
  p.Progression.Challenge={Id=id,EndsAt=now+boss.Duration,Success=roll&lt;self.bossChance(p,id),Team=team}
  return true,'Boss challenge started. Results are calculated by your card team.'
 end
 function self.setProgress(p,set)
  local owned=0;for _,id in ipairs(set.Cards) do if (p.Collection[id] or 0)&gt;0 then owned+=1 end end
  return owned,#set.Cards
 end
 function self.collectionLuck(p)
  local bonus=0
  for _,set in ipairs(config.CollectionSets) do local owned,needed=self.setProgress(p,set);if owned==needed then bonus+=.02 end end
  return bonus
 end
 function self.public(p,now)
  local s=p.Progression
  local variants={};for id,v in pairs(s.Variants) do variants[id]=table.clone(v) end
  return {Quests=table.clone(s.Quests),Sets=table.clone(s.Sets),Formation=s.Formation,Team=table.clone(s.Team),Levels=table.clone(s.Levels),Claims=table.clone(s.Claims),DailyDay=s.DailyDay,DailyStreak=s.DailyStreak,Worlds=table.clone(s.Worlds),BossWins=s.BossWins,Variants=variants,Challenge=s.Challenge and {Id=s.Challenge.Id,EndsAt=s.Challenge.EndsAt} or nil,MasteryXp=table.clone(s.MasteryXp),Awakened=table.clone(s.Awakened),Discoveries=table.clone(s.Discoveries),Chapters=table.clone(s.Chapters),Weekly=self.eventProgress(p,now or os.time()),CoopClaims=table.clone(s.CoopClaims)}
 end
 function self.act(p,action,arg,now)
  local s=p.Progression
  if action=='Team' then
   if type(arg)~='string' or not config.Cards[arg] or (p.Collection[arg] or 0)&lt;1 then return false,'Card not owned' end
   local index=table.find(s.Team,arg)
   if index then table.remove(s.Team,index)
   elseif #s.Team&lt;5 then table.insert(s.Team,arg)
   else return false,'Your team has five cards. Remove one first.' end
   return true,#s.Team==0 and 'Automatic best team enabled' or 'Expedition team updated'
  elseif action=='Upgrade' then
   if type(arg)~='string' or not config.Cards[arg] or (p.Collection[arg] or 0)&lt;1 then return false,'Card not owned' end
   local cost=self.upgradeCost(p,arg)
   if not cost then return false,'Maximum card level reached' end
   if p.Collection[arg]&lt;2 or ((s.Variants[arg] or {}).Normal or 0)&lt;1 then return false,'Upgrade needs a normal duplicate. Rare variants and your last copy are protected.' end
   if p.Coins&lt;cost.Coins or p.Essence&lt;cost.Essence then return false,'Not enough coins or essence' end
   self.consumeDuplicate(p,arg); p.Coins-=cost.Coins; p.Essence-=cost.Essence
   s.Levels[arg]=(s.Levels[arg] or 1)+1
   return true,config.Cards[arg].Name..' upgraded to level '..s.Levels[arg]
  elseif action=='Salvage' then
   if type(arg)~='string' or not config.Cards[arg] or (p.Collection[arg] or 0)&lt;2 then return false,'Only duplicates can be recycled' end
   if not self.consumeDuplicate(p,arg) then return false,'Only normal duplicates can be recycled. Rare variants are protected.' end
   local reward=(ranks[config.Cards[arg].Rarity] or 1)*3
   p.Essence+=reward
   return true,'Duplicate recycled: +'..reward..' essence'
  elseif action=='Awaken' then
   if type(arg)~='string' or not config.Cards[arg] or (p.Collection[arg] or 0)&lt;1 then return false,'Card not owned' end
   if s.Awakened[arg] then return false,'Card already awakened' end
   local recipe=config.Awakening
   if (s.Levels[arg] or 1)&lt;recipe.Level or self.masteryRank(p,arg)&lt;recipe.MasteryRank or s.BossWins&lt;recipe.BossWins then return false,'Reach card level 25, mastery rank 5 and three boss victories' end
   if p.Essence&lt;recipe.Essence or p.Crystals&lt;recipe.Crystals then return false,'Not enough awakening materials' end
   p.Essence-=recipe.Essence;p.Crystals-=recipe.Crystals;s.Awakened[arg]=true
   return true,config.Cards[arg].Name..' awakened!'
  elseif action=='Discover' then
   local known=false
   for world,list in pairs(config.Discoveries) do
    for _,id in ipairs(list) do if id==arg and s.Worlds[world] then known=true end end
   end
   if not known then return false,'This memory cannot be reached yet' end
   if s.Discoveries[arg] then return false,'Memory already discovered' end
   s.Discoveries[arg]=true;p.Coins+=20;p.Essence+=2
   return true,'Memory discovered: '..config.DiscoveryNames[arg]..' (+20 coins, +2 essence)'
  elseif action=='Chapter' then
   local chapter=type(arg)=='string' and config.Chapters[arg]
   if not chapter then return false,'Unknown chapter' end
   if s.Chapters[arg] then return false,'Chapter already completed' end
   local index=table.find(config.ChapterOrder,arg)
   if index&gt;1 and not s.Chapters[config.ChapterOrder[index-1]] then return false,'Finish the previous chapter first' end
   if not s.Worlds[chapter.World] or p.Completed&lt;chapter.Completed or s.BossWins&lt;chapter.BossWins then return false,'Chapter objectives incomplete' end
   for _,id in ipairs(config.Discoveries[chapter.World]) do if not s.Discoveries[id] then return false,'Explore every memory in this world' end end
   s.Chapters[arg]=true;p.Coins+=chapter.Coins;p.Essence+=chapter.Essence;self.addCard(p,chapter.Card,'Normal')
   return true,chapter.Name..' complete! Guaranteed '..config.Cards[chapter.Card].Name
  elseif action=='EventClaim' then
   local milestone
   for _,candidate in ipairs(config.WeeklyMilestones) do if candidate.Id==arg then milestone=candidate end end
   if not milestone then return false,'Unknown weekly reward' end
   local event,week=self.event(now)
   local weekly=s.Weekly
   if weekly.Week~=week or weekly.Points&lt;milestone.Points then return false,'Earn more weekly points first' end
   if weekly.Claims[arg] then return false,'Weekly reward already claimed' end
   weekly.Claims[arg]=true;p.Coins+=milestone.Coins;p.Essence+=milestone.Essence
   if milestone.EventCard then self.addCard(p,event.Card,'Normal') end
   return true,milestone.EventCard and ('Weekly reward claimed! Guaranteed '..config.Cards[event.Card].Name) or 'Weekly reward claimed!'
  elseif action=='Formation' then
   local def=type(arg)=='string' and config.Formations[arg]
   if not def then return false,'Unknown formation' end
   if p.Completed&lt;def.Completed then return false,'Complete '..def.Completed..' expeditions to unlock this formation' end
   s.Formation=arg;return true,'Showcase formation: '..arg
  elseif action=='Quest' then
   local quest=type(arg)=='string' and config.Quests[arg]
   if not quest then return false,'Unknown quest' end
   if s.Quests[arg] then return false,'Quest already claimed' end
   local value=quest.Stat=='BossWins' and s.BossWins or (p[quest.Stat] or 0)
   if value&lt;quest.Target then return false,'Quest objective incomplete' end
   s.Quests[arg]=true;p.Coins+=quest.Coins;self.addCard(p,quest.Card,'Normal')
   return true,'Quest complete! Guaranteed '..config.Cards[quest.Card].Name
  elseif action=='CollectionSet' then
   local found;for _,set in ipairs(config.CollectionSets) do if set.Id==arg then found=set end end
   if not found then return false,'Unknown collection set' end
   if s.Sets[found.Id] then return false,'Set reward already claimed' end
   local owned,needed=self.setProgress(p,found)
   if owned&lt;needed then return false,'Discover every card in this set first' end
   s.Sets[found.Id]=true;p.Coins+=found.Coins;p.Essence+=found.Essence
   return true,'Collection set completed: '..found.Name
  elseif action=='UnlockWorld' then
   local world=type(arg)=='string' and config.Worlds[arg]
   if not world then return false,'Unknown world' end
   if s.Worlds[arg] then return false,'World already unlocked' end
   if p.Completed&lt;world.Completed then return false,'Complete '..world.Completed..' expeditions first' end
   if p.Coins&lt;world.Cost then return false,'Not enough coins' end
   p.Coins-=world.Cost;s.Worlds[arg]=true;return true,world.Name..' unlocked!'
  elseif action=='ClaimBoss' then
   local challenge=s.Challenge
   if not challenge then return false,'No boss challenge active' end
   if now&lt;challenge.EndsAt then return false,'Challenge is still running' end
   local boss=config.Bosses[challenge.Id];s.Challenge=nil
   self.grantMastery(p,challenge.Team,challenge.Success and 50 or 12)
   self.addEventPoints(p,now,challenge.Success and 3 or 1)
   if challenge.Success then
    s.BossWins+=1;p.Coins+=boss.Reward;p.Essence+=boss.Essence;p.Crystals+=boss.Crystals
    return true,'Boss defeated! +'..boss.Reward..' coins, materials awarded'
   end
   p.Coins+=math.floor(boss.Reward*.1);return true,'Challenge failed. Consolation coins awarded; improve your team and retry.'
  elseif action=='Daily' then
   local day=math.floor(now/86400)
   if s.DailyDay&gt;=day then return false,'Daily reward already claimed. Resets at 00:00 UTC.' end
   s.DailyStreak=s.DailyDay==day-1 and s.DailyStreak%7+1 or 1
   s.DailyDay=day
   local reward=100+s.DailyStreak*25; p.Coins+=reward; p.Essence+=s.DailyStreak
   self.addEventPoints(p,now,1)
   return true,'Daily day '..s.DailyStreak..': +'..reward..' coins, +'..s.DailyStreak..' essence'
  elseif action=='Achievement' then
   local goal
   for _,g in ipairs(config.Achievements) do if g.Id==arg then goal=g; break end end
   if not goal then return false,'Unknown achievement' end
   if s.Claims[goal.Id] then return false,'Reward already claimed' end
   local value=p[goal.Stat] or 0
   if goal.Stat=='Unique' then value=0; for _,n in pairs(p.Collection) do if n&gt;0 then value+=1 end end end
   if value&lt;goal.Target then return false,'Achievement not complete' end
   s.Claims[goal.Id]=true; p.Coins+=goal.Coins; p.Essence+=goal.Essence
   return true,'Achievement claimed: '..goal.Name
  end
  return nil
 end
 return self
end
return P
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="NEXUS_SOURCE_03">
      <Properties>
        <string name="Name">NexusSummonVisual</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Cosmetic reel sequence. The server has already awarded the winning card.
local Visual={}
function Visual.new(config)
 local api={}
 local pools={}
 for packId,pack in pairs(config.Packs) do
  local byRarity={};local weighted={};local weightSum=0
  for _,rarity in ipairs(config.Rarities) do
   local cards={}
   if (pack.Weights[rarity] or 0)&gt;0 then
    for id,card in pairs(config.Cards) do
     if card.Rarity==rarity and card.Enabled~=false then table.insert(cards,id) end
    end
    table.sort(cards)
   end
   byRarity[rarity]=cards
   if #cards&gt;0 then
    local weight=pack.Weights[rarity]
    weightSum+=weight
    table.insert(weighted,{Rarity=rarity,EndAt=weightSum})
   end
  end
  pools[packId]={Cards=byRarity,Weights=weighted,Total=weightSum}
 end
 function api.sequence(packId,winnerId,rng)
  local pool=pools[packId]
  if not pool or not config.Cards[winnerId] then return nil end
  local winner=config.Cards[winnerId]
  if winner.Enabled==false or (config.Packs[packId].Weights[winner.Rarity] or 0)&lt;=0 then return nil end
  local count=38;local winningIndex=34;local ids={}
  for index=1,count do
   if index==winningIndex then ids[index]=winnerId
   else
    local pick=rng:NextNumber(0,pool.Total)
    local rarity=pool.Weights[#pool.Weights].Rarity
    for _,entry in ipairs(pool.Weights) do if pick&lt;entry.EndAt then rarity=entry.Rarity;break end end
    local candidates=pool.Cards[rarity]
    ids[index]=candidates[rng:NextInteger(1,#candidates)]
   end
  end
  return ids,winningIndex
 end
 return api
end
return Visual
</ProtectedString>
      </Properties>
