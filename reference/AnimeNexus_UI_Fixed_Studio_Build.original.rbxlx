      <Item class="LocalScript" referent="RBX00000010">
        <Properties>
          <string name="Name">NexusClient</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local MarketplaceService=game:GetService("MarketplaceService")
local me=Players.LocalPlayer
local gui=Instance.new("ScreenGui");gui.Name="AnimeNexusHybridGui";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.Parent=me:WaitForChild("PlayerGui")
local Config=nil
local Remote=nil
local Update=nil
local Notify=nil
local function make(class,parent,props)
 local o=Instance.new(class)
 for k,v in pairs(props or {}) do o[k]=v end
 o.Parent=parent;return o
end
local dark=Color3.fromRGB(19,23,43);local lighter=Color3.fromRGB(33,39,67);local accent=Color3.fromRGB(98,185,255)
local main=make("Frame",gui,{Size=UDim2.fromScale(.64,.78),Position=UDim2.fromScale(.18,.11),BackgroundColor3=dark,BorderSizePixel=0})
make("UICorner",main,{CornerRadius=UDim.new(0,15)})
make("UISizeConstraint",main,{MinSize=Vector2.new(590,400),MaxSize=Vector2.new(1100,770)})
local title=make("TextLabel",main,{Position=UDim2.fromScale(.035,.025),Size=UDim2.fromScale(.67,.075),Text="ANIME NEXUS  |  RIFT COLLECTION",Font=Enum.Font.GothamBold,TextScaled=true,TextColor3=Color3.new(1,1,1),BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left})
local wallet=make("TextLabel",main,{Position=UDim2.fromScale(.69,.033),Size=UDim2.fromScale(.28,.05),Text="",Font=Enum.Font.GothamBold,TextScaled=true,TextColor3=Color3.fromRGB(255,216,111),BackgroundTransparency=1})
local tabs=make("Frame",main,{Position=UDim2.fromScale(.035,.12),Size=UDim2.fromScale(.93,.085),BackgroundTransparency=1})
make("UIListLayout",tabs,{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(.012,0),SortOrder=Enum.SortOrder.LayoutOrder})
local panel=make("ScrollingFrame",main,{Position=UDim2.fromScale(.035,.22),Size=UDim2.fromScale(.93,.66),BackgroundColor3=lighter,BorderSizePixel=0,CanvasSize=UDim2.fromOffset(0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=6})
make("UICorner",panel,{CornerRadius=UDim.new(0,10)})
make("UIPadding",panel,{PaddingTop=UDim.new(0,12),PaddingBottom=UDim.new(0,12),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12)})
local layout=make("UIListLayout",panel,{Padding=UDim.new(0,9),SortOrder=Enum.SortOrder.LayoutOrder})
local toast=make("TextLabel",main,{Position=UDim2.fromScale(.04,.91),Size=UDim2.fromScale(.92,.065),BackgroundTransparency=1,TextColor3=accent,Text="Welcome to the Nexus",TextScaled=true,Font=Enum.Font.GothamBold})
local state=nil;local tab="Packs";local locked=false
local function text(parent,msg,height,color)
 return make("TextLabel",parent,{Size=UDim2.new(1,-10,0,height or 34),BackgroundTransparency=1,Text=msg,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextColor3=color or Color3.new(1,1,1),Font=Enum.Font.Gotham,TextSize=16})
end
local function button(parent,msg,callback,height)
 local b=make("TextButton",parent,{Size=UDim2.new(1,-12,0,height or 43),BackgroundColor3=Color3.fromRGB(50,75,120),TextColor3=Color3.new(1,1,1),Text=msg,TextSize=16,Font=Enum.Font.GothamBold,BorderSizePixel=0})
 make("UICorner",b,{CornerRadius=UDim.new(0,7)})
 b.Activated:Connect(callback);return b
end
local function request(action,arg)
 if locked then return end
 locked=true
 local ok,result=pcall(function()return Remote:InvokeServer(action,arg)end)
 locked=false
 if not ok then toast.Text="Could not contact server";return end
 if result and result.Profile then state=result.Profile end
 if result and result.Message then toast.Text=result.Message end
 if result and not result.Ok then toast.Text=result.Message or "Action failed" end
 return result
end
local render
local function action(name,arg)
 local r=request(name,arg)
 if r and r.Ok and name=="Open" then
  local c=Config.Cards[r.Id]
  toast.Text="SUMMONED: "..c.Name.." ["..r.Rarity.."]!"
 end
 render()
end
local function sortedCardIds()
 local ids={};for id,c in pairs(Config.Cards) do table.insert(ids,id) end
 table.sort(ids,function(a,b)
  local ra=table.find(Config.Rarities,Config.Cards[a].Rarity) or 1
  local rb=table.find(Config.Rarities,Config.Cards[b].Rarity) or 1
  if ra~=rb then return ra&gt;rb end
  return a&lt;b
 end)
 return ids
end
render=function()
 if not state then
  wallet.Text="CONNECTING..."
  for _,c in ipairs(panel:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
  text(panel,"Anime Nexus is starting up. The card collection will appear when the server connects.",80,accent)
  text(panel,"If this stays on screen, open View &gt; Output and look for red error messages. You can still see that the interface script loaded.",80)
  return
 end
 wallet.Text="◈ "..state.Coins.." COINS"
 for _,c in ipairs(panel:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
 if tab=="Packs" then
  text(panel,"Open packs to collect character cards. All currency is earned through gameplay.",43)
  for _,id in ipairs({"basic","elite","cosmic"}) do
   local p=Config.Packs[id];local pity=state.Pity[id] or 0
   text(panel,p.Name.."  •  "..p.Price.." coins  •  Legendary+ pity "..pity.." / "..p.Pity,35,accent)
   text(panel,p.Description.." | Current odds shown below (pity overrides next guaranteed pull)",38)
   local odd=state.Odds and state.Odds[id] or p.Weights
   local list={};for _,rarity in ipairs(Config.Rarities) do
    if (odd[rarity] or 0)&gt;0 then table.insert(list,rarity.." "..string.format("%.4f",odd[rarity]).."%") end
   end
   text(panel,table.concat(list,"  |  "),70)
   text(panel,"Individual card odds: divide rarity percentage equally among cards in that rarity (two or one per tier).",43)
   button(panel,"OPEN "..string.upper(p.Name),function()action("Open",id)end)
  end
  text(panel,"Pity resets after any Legendary, Mythic or Celestial. Luck reweights Epic+ odds.",55)
 elseif tab=="Cards" then
  text(panel,"Owned cards: choose up to 3 favourites to showcase behind your avatar.",42,accent)
  for _,id in ipairs(sortedCardIds()) do
   local c=Config.Cards[id];local count=state.Collection[id] or 0
   if count&gt;0 then
    local fav=table.find(state.Favorites,id)~=nil
    text(panel,c.Name.."  |  "..c.Rarity.."  |  x"..count,30,Config.RarityColors[c.Rarity])
    text(panel,"Power "..c.Power.." · Speed "..c.Speed.." · Defence "..c.Defense.." · Energy "..c.Energy.." · "..c.Trait,37)
    button(panel,fav and "★ REMOVE FAVOURITE" or "☆ ADD FAVOURITE",function()action("Favorite",id)end,37)
   end
  end
 elseif tab=="Expeditions" then
  local power=0;local scores={}
  for id,count in pairs(state.Collection) do if count&gt;0 and Config.Cards[id] then
   local c=Config.Cards[id];table.insert(scores,c.Power+c.Speed*.35+c.Defense*.35+c.Energy*.3)
  end end
  table.sort(scores,function(a,b)return a&gt;b end);for i=1,math.min(5,#scores) do power+=scores[i] end
  text(panel,"Top 5 unique owned cards automatically form your expedition team.",42)
  text(panel,"Team Power: "..math.floor(power).." | Expeditions completed: "..state.Completed,35,accent)
  if state.Expedition then
   local e=Config.Expeditions[state.Expedition.Id]
   local remaining=math.max(0,state.Expedition.EndsAt-os.time())
   text(panel,e.Name.." | "..remaining.." seconds remaining (refresh to update)",42)
   button(panel,"CLAIM COMPLETED EXPEDITION",function()action("ClaimExpedition")end)
  else
   for _,id in ipairs({"scouting","citadel","abyss"}) do
    local e=Config.Expeditions[id]
    text(panel,e.Name.."  |  "..e.Duration.."s  |  Recommended power "..e.RequiredPower.."  |  Reward "..e.Reward,43,accent)
    button(panel,"START (requires "..e.Unlock.." completions)",function()action("StartExpedition",id)end)
   end
  end
  text(panel,"Underpowered teams may fail and get 20% of normal reward. Progress continues while offline.",56)
 elseif tab=="Potions" then
  text(panel,"Craft luck potions from expedition materials, or buy potions with Robux where permitted.",58,accent)
  text(panel,"Essence: "..(state.Essence or 0).."  |  Crystals: "..(state.Crystals or 0),32)
  if state.ActivePotion and state.ActivePotion.EndsAt&gt;os.time() then
   text(panel,"Active: "..Config.Potions[state.ActivePotion.Id].Name.." (expires "..os.date("!%H:%M UTC",state.ActivePotion.EndsAt)..")",45)
  end
  for _,id in ipairs({"minor","major"}) do
   local potion=Config.Potions[id];local ing=potion.Ingredients
   text(panel,potion.Name.." | +"..math.floor(potion.Bonus*100).."% high-rarity weight factor | "..math.floor(potion.Duration/60).." min | Owned: "..(state.Potions[id] or 0),55,accent)
   button(panel,"CRAFT — "..ing.Essence.." Essence + "..ing.Crystals.." Crystals",function()action("CraftPotion",id)end)
   button(panel,"USE POTION",function()action("UsePotion",id)end)
   local productId=Config.Monetization.PotionProductIds[id]
   if state.PaidLuckAvailable and productId&gt;0 then
    button(panel,"BUY POTION WITH ROBUX",function()
     MarketplaceService:PromptProductPurchase(me,productId)
    end)
   end
  end
 elseif tab=="Luck" then
  local cost=Config.LuckUpgradeCosts[state.Luck+1] or 0
  local required=Config.LuckExpeditionRequirements[state.Luck+1] or 0
  text(panel,"Luck upgrades permanently improve relative odds of Epic, Legendary, Mythic and Celestial cards.",70)
  text(panel,"Luck level: "..state.Luck.." / "..Config.LuckMaxLevel,44,accent)
  text(panel,"Epic+ weight multiplier: x"..string.format("%.2f",1+state.Luck*Config.LuckBonusPerLevel),44)
  text(panel,"Requires "..required.." completed expeditions. Next upgrade: "..cost.." Rift Coins.",45)
  button(panel,state.Luck&gt;=Config.LuckMaxLevel and "MAX LUCK" or ("UPGRADE LUCK  —  "..cost.." coins"),function()action("Luck")end)
  text(panel,"Paid 2x luck pass: "..(state.HasLuckPass and "OWNED" or "NOT OWNED").." | Access: "..(state.PaidLuckAvailable and "eligible" or "not available"),45)
  if state.PaidLuckAvailable and Config.Monetization.LuckPassId&gt;0 then
   button(panel,"GET PERMANENT 2X LUCK PASS",function()
    MarketplaceService:PromptGamePassPurchase(me,Config.Monetization.LuckPassId)
   end)
   button(panel,"REFRESH OWNERSHIP",function()action("RefreshPass")end)
  end
  text(panel,"Luck does not increase the total chance of every rarity independently; pack weights are normalised after bonuses. Pity is tracked separately for each pack.",80)
 end
end
for _,name in ipairs({"Packs","Cards","Expeditions","Luck","Potions"}) do
 local b=make("TextButton",tabs,{Size=UDim2.new(.188,0,1,0),BackgroundColor3=Color3.fromRGB(46,59,99),Text=name,Font=Enum.Font.GothamBold,TextScaled=true,TextColor3=Color3.new(1,1,1),BorderSizePixel=0})
 make("UICorner",b,{CornerRadius=UDim.new(0,7)})
 b.Activated:Connect(function()tab=name;render()end)
end
render()
toast.Text="Loading game services..."
task.spawn(function()
 local configModule=ReplicatedStorage:WaitForChild("NexusConfig",20)
 local remotes=ReplicatedStorage:WaitForChild("NexusRemotes",20)
 if not configModule or not remotes then
  toast.Text="Setup problem: NexusConfig or NexusRemotes missing. Check Output."
  warn("ANIME NEXUS: Missing NexusConfig or NexusRemotes after 20s")
  return
 end
 local ok,loaded=pcall(require,configModule)
 if not ok then
  toast.Text="NexusConfig has a Lua error. Check Output."
  warn("ANIME NEXUS: NexusConfig error:",loaded)
  return
 end
 Config=loaded
 Remote=remotes:WaitForChild("Request",15)
 Update=remotes:WaitForChild("Updated",15)
 Notify=remotes:WaitForChild("Notify",15)
 if not Remote or not Update or not Notify then
  toast.Text="Server network setup incomplete. Check Output."
  return
 end
 Update.OnClientEvent:Connect(function(p)state=p;render()end)
 Notify.OnClientEvent:Connect(function(s)toast.Text=s end)
 for attempt=1,30 do
  local r=request("Get")
  if r and r.Ok then state=r.Profile;render();toast.Text="Welcome to the Nexus! Open a Rift Pack to start.";return end
  if attempt%5==0 then toast.Text="Waiting for collection data (attempt "..attempt.."/30)..." end
  task.wait(1)
 end
 toast.Text="Could not load profile. Check Studio Output for a DataStore error."
 warn("ANIME NEXUS: Profile could not be fetched after 30 attempts")
end)
